#!/usr/bin/env bash
# bin/prime — the one command that proves core still agrees with itself.
#
#   bin/prime            # setup (if needed) + full suite
#   bin/prime --pytest   # same suite, through pytest instead of the script
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(dirname "$here")"
venv="$root/tests/.venv"
python="$venv/bin/python"

if [ ! -x "$python" ]; then
  "$root/tests/setup.sh"
fi

cd "$root"
if [ "${1:-}" = "--pytest" ]; then
  exec "$python" -m pytest tests -q
fi
exec "$python" tests/test_specs.py
